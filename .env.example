# ---- Storage ----------------------------------------------------------------
# Postgres connection string, e.g. Supabase (required on Vercel). Leave unset to use a local file.
# Supabase: Project › Connect › "Transaction pooler" (port 6543), with your database password filled in.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local file location when DATABASE_URL isn't set (default ./data/cv-tailor.db).
# DATABASE_PATH=./data/cv-tailor.db

# ---- Accounts (optional: invite-only, multi-user) ----------------------------
# With these set, people sign in with Google by invitation and each gets their own
# data. See "Accounts: invite other people" in the README.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Signs sign-in cookies. Generate with: openssl rand -hex 32
# SESSION_SECRET=
# Your Google email: always allowed in, and manages invites.
# OWNER_EMAIL=

# ---- Access (single user, without accounts) --------------------------------
# Password for the web app. Required on Vercel unless accounts are set up; optional locally.
# APP_PASSWORD=
# Secret for the MCP endpoint. Required for anything not on localhost
# (Vercel, tunnels, claude.ai, ChatGPT). With accounts, it keeps working as the
# owner's key. Generate with: openssl rand -hex 24
# MCP_TOKEN=

# Address of the web app, used in links your chat receives.
# Defaults to Vercel's production address on Vercel, else http://localhost:3000.
# APP_URL=

# ---- Optional AI ------------------------------------------------------------
# Not needed: your chat app does the writing. With a key, a pasted job
# description gets a better first-pass read before your chat refines it.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5
